# Copy to .env and edit. Compose reads .env automatically.

# Optional app login. Leave both empty to disable basic auth.
APP_USER=admin
APP_PASS=change-me

# Optional media override. Leave empty to use the page's HTTPS origin
# (recommended when TLS is terminated by your reverse proxy). Set it only if
# the TV needs a different URL it can reach, e.g. a routed private address.
CAST_MEDIA_BASE=

# UID/GID that own ./data. Check with: id -u && id -g
PUID=1000
PGID=1000

TZ=UTC

# Incoming torrent port (TCP/UDP). Change if 51413 is already in use.
TORRENT_PORT=51413

# Optional
TMDB_API_KEY=
NETMIRROR_BASE=
